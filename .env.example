# Codebase RAG - Environment Configuration
# Copy this file to .env and fill in your values

# Application
APP_ENV=development
APP_NAME=Codebase RAG
API_PREFIX=/api/v1
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_PORT=5173

# Database
# For local Docker Compose, use: postgresql+psycopg://postgres:postgres@db:5432/codebase_rag
# Compose PostgreSQL is published on localhost:5433 to avoid colliding with a native PostgreSQL service.
# For local development outside Docker, use: postgresql+psycopg://postgres:postgres@localhost:5433/codebase_rag
DATABASE_URL=postgresql+psycopg://postgres:postgres@db:5432/codebase_rag

# CORS - Comma-separated list of allowed origins
CORS_ORIGINS_STR=http://localhost:5173

# Upload Limits
MAX_UPLOAD_MB=50
MAX_ARCHIVE_FILES=10000
MAX_UNCOMPRESSED_MB=300
MAX_SINGLE_FILE_MB=5
MAX_ARCHIVE_PATH_LENGTH=1024
MAX_ARCHIVE_COMPRESSION_RATIO=1000
MAX_DEPENDENCY_QUERIES=1000
MAX_DEPENDENCY_ADVISORIES=100
OSV_API_URL=https://api.osv.dev/v1/querybatch
OSV_TIMEOUT_SECONDS=5

# Chunking Configuration
CHUNK_SIZE=1200
CHUNK_OVERLAP=150

# Retrieval Configuration
RETRIEVAL_TOP_K=6

# LLM Provider Configuration
# Options: openai_compatible, none
LLM_PROVIDER=none
# Base URL for OpenAI-compatible API (e.g., http://localhost:11434/v1 for Ollama, https://api.openai.com/v1)
LLM_BASE_URL=
# API Key for the LLM provider
LLM_API_KEY=
# Model name (e.g., gpt-4, nemotron-3-ultra, llama2, etc.)
LLM_MODEL=
# Request timeout in seconds
LLM_TIMEOUT_SECONDS=60

# Embedding Provider Configuration
# Options: openai_compatible, sentence_transformers, none
EMBEDDING_PROVIDER=none
# Base URL for OpenAI-compatible embeddings API
EMBEDDING_BASE_URL=
# API Key for embeddings provider
EMBEDDING_API_KEY=
# Model name (e.g., sentence-transformers/all-MiniLM-L6-v2, text-embedding-3-small)
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# Vector dimensions (384 for all-MiniLM-L6-v2, 1536 for text-embedding-3-small)
EMBEDDING_DIMENSIONS=384

# AWS Configuration (Optional - for cloud deployment)
AWS_REGION=
S3_BUCKET=
SQS_QUEUE_URL=
